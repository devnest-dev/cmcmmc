NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=registration-uploads
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
STAFF_USERNAME=staff
STAFF_PASSWORD=staff123
NEXT_PUBLIC_BASE_URL=https://example.com
SEND_CONFIRMATION_EMAIL=true
# Long random string used to HMAC-hash voter emails before storing them.
# Never rotate this mid-competition (repeat-vote detection depends on it staying stable).
VOTE_EMAIL_HASH_SECRET=
# Google OAuth 2.0 Client ID/Secret for "Sign in with Google" vote verification.
# Create these in Google Cloud Console (OAuth consent screen + Web application
# OAuth client), with an authorized redirect URI of
# <NEXT_PUBLIC_BASE_URL>/api/auth/google/callback (and http://localhost:3000/... for dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string (e.g. `openssl rand -hex 32`) used to sign the OAuth `state`
# parameter. Distinct from VOTE_EMAIL_HASH_SECRET -- different purpose, different secret.
GOOGLE_OAUTH_STATE_SECRET=